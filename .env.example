# ---------------------------------------------------------------------------
# IYKOMO-TECH COMMUNICATION — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# IMPORTANT: `.env` is git-ignored. Never commit real secrets to GitHub.
# ---------------------------------------------------------------------------

# ---- REQUIRED: PostgreSQL connection string ----
# Local development (default):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Production (Supabase example — get it from Project Settings > Database):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Production (Neon example):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# ---- REQUIRED in production: session signing secret ----
# Generate one with:  openssl rand -base64 48
# If left blank, a development fallback is used (NOT safe for production).
JWT_SECRET=change-me-to-a-long-random-string-in-production

# ---- Optional: Node environment ----
# NODE_ENV=production
